cat > templates/index.html <<'HTML'
<!DOCTYPE html>
<html>
<head>
    <title>Network Scanner Tool</title>
    <link rel="stylesheet"
    href="{{ url_for('static', filename='style.css') }}">
</head>
<body>

<div class="container">
    <h1>NETWORK SCANNER TOOL</h1>
    <p>Cybersecurity Network Monitoring System</p>

    <form method="POST">
        <input type="text" name="target"
        placeholder="Enter target IP address"
        required>

        <button type="submit">START SCAN</button>
    </form>

    {% if error %}
    <h3>{{ error }}</h3>
    {% endif %}

    {% if results %}
    <h2>SCAN RESULTS</h2>
    <pre>{% for line in results %}{{ line }}
{% endfor %}</pre>
    {% endif %}
</div>

</body>
</html>
HTML